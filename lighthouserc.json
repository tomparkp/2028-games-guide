{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-prod.mjs",
      "startServerReadyPattern": "Serving production build",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/?session=ATH15",
        "http://localhost:4173/privacy"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:4173/(privacy)?$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }]
          }
        },
        {
          "matchingUrlPattern": "\\?session=",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.85 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 4000 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
